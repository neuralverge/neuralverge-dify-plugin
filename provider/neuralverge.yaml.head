identity:
  author: "neuralverge"
  name: "neuralverge"
  label:
    en_US: "NeuralVerge"
  description:
    en_US: "Structured, cited, real-world data from 300+ sources and the open web: web search, AI page extraction, company registries, marketplaces, reviews and more."
  icon: "icon.svg"
  icon_dark: "icon-dark.svg"
  tags:
    - search
    - business
    - utilities
credentials_for_provider:
  api_key:
    type: secret-input
    required: true
    label:
      en_US: "API key"
    placeholder:
      en_US: "Your NeuralVerge API key"
    help:
      en_US: "Create a key in the NeuralVerge dashboard under Settings → API."
    url: "https://neuralverge.ai"
